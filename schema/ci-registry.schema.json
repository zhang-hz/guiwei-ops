{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GUIWEI CI 套件注册表",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportVersion", "suites"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportVersion": { "const": 1 },
    "suites": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": { "$ref": "#/$defs/suite" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 96,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "path": {
      "type": "string", "minLength": 1, "maxLength": 384,
      "pattern": "^(?!.*(?:^|/)(?:\\.{1,2}|\\.git[^/]*|node_modules)(?:/|$))[A-Za-z0-9_@.-]+(?:/[A-Za-z0-9_@.-]+)*$"
    },
    "profile": { "enum": ["fast", "local", "pr", "release", "extended"] },
    "tier": {
      "enum": ["integrity", "static", "unit", "module", "database", "contract", "system", "e2e", "security", "docs", "nonfunctional"]
    },
    "suite": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "tier", "owner", "files", "dependsOn", "profiles", "scopes", "environment", "adapter", "resources", "isolation", "timeoutMs", "cleanupTimeoutMs"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "tier": { "$ref": "#/$defs/tier" },
        "owner": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
        "files": {
          "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "dependsOn": {
          "type": "array", "maxItems": 4096, "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "profiles": {
          "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
          "items": { "$ref": "#/$defs/profile" }
        },
        "scopes": {
          "type": "array", "maxItems": 256, "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "environment": { "const": "isolated" },
        "adapter": {
          "type": "object", "additionalProperties": false,
          "required": ["runtime", "entrypoint", "args"],
          "properties": {
            "runtime": { "const": "node" },
            "entrypoint": { "$ref": "#/$defs/path" },
            "args": {
              "type": "array", "maxItems": 32,
              "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!.*\\.\\.)[A-Za-z0-9_./:=,@-]+$" }
            }
          }
        },
        "resources": {
          "type": "object", "additionalProperties": false,
          "required": ["cpus", "memoryMb", "pids", "outputBytes"],
          "properties": {
            "cpus": { "type": "integer", "minimum": 1, "maximum": 4 },
            "memoryMb": { "type": "integer", "minimum": 128, "maximum": 4096 },
            "pids": { "type": "integer", "minimum": 16, "maximum": 512 },
            "outputBytes": { "type": "integer", "minimum": 1024, "maximum": 8388608 }
          }
        },
        "isolation": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "network"],
          "properties": { "kind": { "const": "container" }, "network": { "const": "none" } }
        },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 3600000 },
        "cleanupTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 }
      }
    }
  }
}
